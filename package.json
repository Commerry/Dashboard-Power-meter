{
  "name": "power-center",
  "version": "1.0.0",
  "description": "Multi-plant power meter monitoring center (Schneider / Modbus / MQTT / Siemens S7) with realtime dashboard, alarms, peak-demand control, reports and public API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/tools/dev.js",
    "seed": "node src/seed.js",
    "user:add": "node src/tools/user.js add",
    "user:passwd": "node src/tools/user.js passwd"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "dseg": "^0.46.0",
    "express": "^4.18.2",
    "modbus-serial": "^8.0.17",
    "nodes7": "^0.3.18",
    "uplot": "^1.6.31",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "mqtt": "^5.10.1",
    "serialport": "^12.0.0",
    "node-snap7": "^1.0.9"
  },
  "engines": {
    "node": ">=18"
  }
}
