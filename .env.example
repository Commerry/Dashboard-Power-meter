# Power Center configuration
PORT=8095

# Dashboard name shown in the header, login page and browser tab
SITE_NAME=POWER CENTER
SITE_SUBTITLE=PSE Energy Monitor

# First-run admin account (only used when the users table is empty)
ADMIN_USER=admin
ADMIN_PASS=admin

# First-run seed: real Siemens S7 PLCs (DB1004 energy summary) - comma list of IPs, blank = none
SEED_PLC_IPS=10.22.181.12,10.22.181.19,10.22.181.26
# Also seed a demo plant with simulated meters (1 = yes) - off by default
SEED_DEMO=0

# Session lifetime (hours)
SESSION_HOURS=12

# Timezone used for reports / exports / daily rollups
REPORT_TZ=Asia/Bangkok

# ---- Polling / storage ----
# default poll interval for a meter when not set per meter (ms)
DEFAULT_POLL_MS=2000
# write one sample per meter to the database at most every N seconds
STORE_INTERVAL_SEC=30
# meter counts as offline after this many seconds without a good read
OFFLINE_AFTER_SEC=30
# gateway stats sample interval (seconds)
GATEWAY_STATS_SEC=60

# ---- Data retention (days) ----
SAMPLES_KEEP_DAYS=90
HOURLY_KEEP_DAYS=730
EVENTS_KEEP_DAYS=365
GATEWAY_STATS_KEEP_DAYS=30
AUDIT_KEEP_DAYS=365

# ---- Outbound integrations (optional) ----
# publish every reading to an MQTT broker: mqtt://host:1883 (blank = off)
MQTT_PUBLISH_URL=
MQTT_PUBLISH_PREFIX=powercenter
MQTT_USERNAME=
MQTT_PASSWORD=

# webhook called on every alarm start/end (blank = off)
ALARM_WEBHOOK_URL=
